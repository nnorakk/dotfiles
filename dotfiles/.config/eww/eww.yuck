; =====================================================================
; eww — widgets de fundo do Hyprland
;
; O eww desenha na layer "bg" (fundo), abaixo de tudo e em todos os
; workspaces. Ha um widget: "saldo" — roda scripts/saldo.sh a cada 5 min;
; o script coleta o dado e traduz o markup para uma arvore de widgets
; (scripts/conky2eww.py), injetada via (literal).
;
; Subir (so darkstar, monitor DP-3):  eww open saldo   (ver host-darkstar.conf)
; =====================================================================

; Arvore de widgets (string) gerada pelo coletor; recarrega a cada 300s.
; :initial evita janela vazia no primeiro tick.
(defpoll saldo_tree
  :interval "300s"
  :initial "(label :class \"saldo\" :text \"carregando...\")"
  `$HOME/.config/eww/scripts/saldo.sh`)

(defwidget saldo []
  (literal :content saldo_tree))

; Janela no FUNDO (:stacking "bottom"), sem reservar espaco e sem foco.
; :monitor aqui e so um FALLBACK: quem escolhe o monitor certo e o launcher
; ~/.config/hypr/scripts/eww-screen.sh, que abre com `--screen <n>` descoberto
; em runtime (casando o monitor pelo modelo) e confere no hyprctl layers que a
; surface subiu, reabrindo em loop se nao (o `eww open` as vezes marca a janela
; como active sem mapear a surface). O
; indice do GDK/eww NAO e estavel entre logins (apos o GDM a ordem inverte),
; e o eww 0.5.0 nao casa por nome/modelo — dai o launcher.
; So darkstar abre esta janela. Ancorada topo-direita.
(defwindow saldo
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "30px"
                      :y "65px"
                      :anchor "top right"
                      :width "510px")
  (saldo))

; =====================================================================
; Widget "relogio" — relogio grande + calendario do mes (estilo post-it).
; Hora/minuto por defpoll (10s); a data por poll de 10min (so muda no dia).
; O calendario e o widget nativo do eww: sem :day/:month/:year ele mostra o
; mes atual e marca o dia de hoje sozinho (dias de outros meses saem esmaecidos).
; =====================================================================
(defpoll clk_hour :interval "10s" :initial "--" `date +%H`)
(defpoll clk_min  :interval "10s" :initial "--" `date +%M`)
(defpoll clk_date :interval "600s" :initial "" `date +'%A, %d %B'`)

(defwidget relogio []
  (box :class "relogio" :orientation "v" :space-evenly false
    (box :class "clock" :orientation "h" :space-evenly false :halign "center"
      (label :class "hh" :text clk_hour)
      (box :class "sep")
      (label :class "mm" :text clk_min))
    (label :class "subdate" :halign "center" :text clk_date)
    (calendar :class "cal")))

(defwindow relogio
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "30px"
                      :y "40px"
                      :anchor "bottom left"
                      :width "340px")
  (relogio))
